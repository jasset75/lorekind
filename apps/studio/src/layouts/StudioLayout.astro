---
import "@lorekind/theme/tokens.css";
import "../styles/global.css";
import { ThemeMode, themeStorageKey } from "@lorekind/theme";
import { translate, Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
}

const { title, description, lang = Locale.English } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline define:vars={{ ThemeMode, themeStorageKey }}>
      (() => {
        const stored = localStorage.getItem(themeStorageKey) ?? ThemeMode.System;
        const resolved =
          stored === ThemeMode.System
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? ThemeMode.Dark
              : ThemeMode.Light
            : stored;
        document.documentElement.dataset.theme = resolved;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#workspace">{translate(lang, "ui.skip")}</a>
    <slot />
  </body>
</html>

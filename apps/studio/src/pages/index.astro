---
import FoldSwitcher from "../components/FoldSwitcher.svelte";
import ThemeSwitcher from "../components/ThemeSwitcher.svelte";
import StudioLayout from "../layouts/StudioLayout.astro";

const entries = [
  { title: "A field guide to independent video", type: "Article", state: "Draft", time: "4m" },
  { title: "Creator channel verification", type: "Policy", state: "Review", time: "18m" },
  { title: "Autumn live programme", type: "Schedule", state: "Ready", time: "1h" },
];
---

<StudioLayout
  title="Lorekind Studio"
  description="Foundation prototype for a community-owned, Git-native CMS."
>
  <div class="studio-shell">
    <header class="topbar">
      <FoldSwitcher client:load />
      <div class="topbar-actions">
        <button class="command" type="button" aria-label="Open command menu">
          <span>Search or jump</span><kbd>⌘ K</kbd>
        </button>
        <ThemeSwitcher client:load />
        <button class="avatar" type="button" aria-label="Open account menu">JA</button>
      </div>
    </header>

    <aside class="sidebar" aria-label="Studio navigation">
      <nav>
        <p class="nav-heading">Workspace</p>
        <a class="nav-item active" href="#overview"><span aria-hidden="true">◫</span>Overview</a>
        <a class="nav-item" href="#content"><span aria-hidden="true">◇</span>Content</a>
        <a class="nav-item" href="#collections"><span aria-hidden="true">▤</span>Collections</a>
        <a class="nav-item" href="#assets"><span aria-hidden="true">◩</span>Assets</a>

        <p class="nav-heading spaced">Workflow</p>
        <a class="nav-item" href="#submissions"><span aria-hidden="true">↗</span>Submissions</a>
        <a class="nav-item" href="#reviews"><span aria-hidden="true">◎</span>Reviews <b>3</b></a>
        <a class="nav-item" href="#releases"><span aria-hidden="true">✓</span>Releases</a>
      </nav>

      <div class="sidebar-note">
        <span class="status-dot"></span>
        <div><strong>Local foundation</strong><small>No remote provider connected</small></div>
      </div>
    </aside>

    <main id="workspace" class="workspace">
      <section class="hero" id="overview">
        <div>
          <p class="overline">Foundation workspace</p>
          <h1>Welcome to your Fold.</h1>
          <p>Shape the Fold, review community work, and keep every decision traceable.</p>
        </div>
        <button class="primary-action" type="button"
          ><span aria-hidden="true">＋</span>New entry</button
        >
      </section>

      <section class="metrics" aria-label="Fold summary">
        <article>
          <span class="metric-icon violet" aria-hidden="true">↗</span>
          <div><strong>8</strong><span>Open submissions</span></div>
          <small>2 need your attention</small>
        </article>
        <article>
          <span class="metric-icon amber" aria-hidden="true">◎</span>
          <div><strong>3</strong><span>Waiting for review</span></div>
          <small>Oldest is 2 days</small>
        </article>
        <article>
          <span class="metric-icon green" aria-hidden="true">✓</span>
          <div><strong>24</strong><span>Published this month</span></div>
          <small>Across 5 collections</small>
        </article>
      </section>

      <section class="content-grid">
        <article class="panel recent-panel">
          <div class="panel-heading">
            <div><p class="overline">Keep moving</p><h2>Recent content</h2></div>
            <a href="#all-content">View all</a>
          </div>
          <div class="entry-list">
            {
              entries.map((entry) => (
                <a class="entry" href="#entry">
                  <span class="document-icon" aria-hidden="true">
                    ▱
                  </span>
                  <span class="entry-copy">
                    <>
                      <strong>{entry.title}</strong>
                      <small>
                        {entry.type} · Updated {entry.time} ago
                      </small>
                    </>
                  </span>
                  <span class:list={["state", entry.state.toLowerCase()]}>{entry.state}</span>
                  <span class="chevron" aria-hidden="true">
                    ›
                  </span>
                </a>
              ))
            }
          </div>
        </article>

        <article class="panel activity-panel">
          <div class="panel-heading">
            <div><p class="overline">Audit trail</p><h2>Fold activity</h2></div>
          </div>
          <ol class="timeline">
            <li>
              <span class="timeline-mark">AM</span><p>
                <strong>Alex submitted</strong> a channel profile<small>12 minutes ago</small>
              </p>
            </li>
            <li>
              <span class="timeline-mark accent">MR</span><p>
                <strong>Marta requested</strong> two changes<small>45 minutes ago</small>
              </p>
            </li>
            <li>
              <span class="timeline-mark dark">LK</span><p>
                <strong>Lorekind CI</strong> validated the Fold<small>1 hour ago</small>
              </p>
            </li>
          </ol>
        </article>
      </section>

      <section class="foundation-banner">
        <span aria-hidden="true">⌁</span>
        <div>
          <strong>Foundation scaffold</strong><p>
            This interface demonstrates the visual system. Writes and Git providers are
            intentionally not connected yet.
          </p>
        </div>
        <a href="https://github.com/jasset75/lorekind/blob/main/ROADMAP.md" rel="noreferrer"
          >Read the roadmap</a
        >
      </section>
    </main>
  </div>
</StudioLayout>
